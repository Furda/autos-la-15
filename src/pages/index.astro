---
import { createImageUrlBuilder } from '@sanity/image-url';
import { sanityClient } from 'sanity:client';
import heroImage from '../../assets/hero-image-large.jpg';
import whoAreWeImage from '../../assets/who-are-we-image.jpg';
import '../styles/global.css';

type SanityImage = {
  asset?: { _ref?: string };
  alt?: string;
  crop?: { top?: number; bottom?: number; left?: number; right?: number };
  hotspot?: { x?: number; y?: number; width?: number; height?: number };
};

type Car = {
  _id: string;
  name: string;
  title?: string;
  year: number;
  price: number;
  description?: string;
  image?: SanityImage;
  status: 'available' | 'reserved';
  featured?: boolean;
  badge?: string;
  whatsappMessage?: string;
  model3d?: { asset?: { _ref?: string } };
};

type Location = { city?: string; address?: string; mapUrl?: string };
type Hour = { label?: string; opening?: string; closing?: string };
type SiteSettings = {
  identity?: { brandName?: string; tagline?: string };
  contact?: { phone?: string; whatsapp?: string; email?: string };
  hours?: Hour[];
  locations?: Location[];
  socialLinks?: { instagram?: string; facebook?: string; tiktok?: string };
  homepageCopy?: { eyebrow?: string; title?: string; description?: string; catalogHeading?: string };
  heroImage?: SanityImage;
};

const siteSettings = (await sanityClient.fetch<SiteSettings | null>(`*[_type == "siteSettings"][0]{
  identity, contact, hours, locations, socialLinks, homepageCopy,
  heroImage{..., "asset": asset, "alt": coalesce(alt, "Vehículos exhibidos en Autos La 15")}
}`)) ?? {};
const cars = await sanityClient.fetch<Car[]>(`*[_type == "car" && status in ["available", "reserved"]]
  | order(featured desc, _createdAt asc, _id asc){
    _id, name, title, year, price, description, image{..., "asset": asset, "alt": coalesce(alt, name)},
    status, featured, badge, whatsappMessage, model3d
  }`);

const config = sanityClient.config();
if (!config.projectId || !config.dataset) throw new Error('Sanity project configuration is required to build image URLs.');
const imageBuilder = createImageUrlBuilder({ projectId: config.projectId, dataset: config.dataset });
const imageUrl = (image: SanityImage | undefined, width: number) =>
  image?.asset?._ref ? imageBuilder.image(image).width(width).auto('format').fit('max').url() : '';
const conditionLabel = (car: Car) => (car.status === 'reserved' ? 'Reservado' : car.badge || 'Disponible');

const homepageCopy = siteSettings.homepageCopy ?? {};
const brandName = siteSettings.identity?.brandName ?? 'AUTOS LA 15';
const tagline = siteSettings.identity?.tagline ?? 'Compra con claridad. Vende con confianza.';
const contact = siteSettings.contact ?? {};
const locations = siteSettings.locations ?? [];
const hours = siteSettings.hours ?? [];
const firstLocation = locations[0];
const whatsappNumber = (contact.whatsapp || contact.phone || '').replace(/[^\d]/g, '');
const generalMessage = 'Hola AUTOS LA 15, quiero más información';
const whatsappHref = (message: string) =>
  whatsappNumber ? `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(message)}` : '#contacto';
const heroSrc = heroImage.src;
const historySrc = whoAreWeImage.src;
const mapSrc = firstLocation?.mapUrl
  ? `${firstLocation.mapUrl}${firstLocation.mapUrl.includes('?') ? '&' : '?'}z=17&output=embed`
  : '';
const siteUrl = import.meta.env.PUBLIC_SITE_URL?.trim();
const canonicalUrl = siteUrl ? new URL('/', siteUrl).toString() : undefined;
const heroOgUrl = siteUrl ? new URL(heroSrc, siteUrl).toString() : heroSrc;
const formatPrice = (price: number) =>
  new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 }).format(price);

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'AutoDealer',
  name: brandName,
  description: homepageCopy.description,
  telephone: contact.phone,
  email: contact.email,
  ...(siteUrl ? { url: siteUrl } : {}),
  areaServed: locations.map((location) => location.city).filter(Boolean),
  address: firstLocation?.address
    ? { '@type': 'PostalAddress', addressLocality: firstLocation.city, streetAddress: firstLocation.address, addressCountry: 'VE' }
    : undefined,
  sameAs: [siteSettings.socialLinks?.instagram, siteSettings.socialLinks?.facebook, siteSettings.socialLinks?.tiktok].filter(Boolean),
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={homepageCopy.description} />
    <meta property="og:title" content={`${brandName} | ${tagline}`} />
    <meta property="og:description" content={homepageCopy.description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={heroOgUrl} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Sora:wght@600;700;800&display=swap" rel="stylesheet" />
    <link rel="icon" href="/assets/img/logo.png" />
    <title>{brandName} | {tagline}</title>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Saltar al contenido</a>

    <header class="site-header" id="top">
      <div class="container header-inner">
        <a href="#top" class="brand" aria-label={`${brandName}, inicio`}>
          <img src="/assets/img/logo.png" alt={`Logo de ${brandName}`} class="brand-logo" width="40" height="40" />
          <span class="brand-text"><strong>{brandName}</strong><small>{tagline}</small></span>
        </a>
        <nav class="main-nav" id="main-nav" aria-label="Navegación principal">
          <a href="#nosotros">Nuestra historia</a>
          <a href="#catalogo">Vehículos</a>
          <a href="#testimonios">Opiniones</a>
          <a href="#faq">Preguntas</a>
          <a href="#contacto">Contacto</a>
        </nav>
        <div class="header-actions">
          <a class="btn btn-whatsapp" href={whatsappHref(generalMessage)} target="_blank" rel="noopener" aria-label="Hablar con Autos La 15 por WhatsApp">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.868-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.226 1.36.194 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12.001 2C6.478 2 2 6.478 2 12c0 1.85.5 3.657 1.451 5.24L2 22l4.897-1.416A9.945 9.945 0 0 0 12.001 22C17.523 22 22 17.522 22 12S17.523 2 12.001 2zm0 18.062a8.012 8.012 0 0 1-4.088-1.118l-.293-.175-2.902.839.848-2.827-.19-.29A8.06 8.06 0 0 1 3.938 12c0-4.446 3.617-8.062 8.063-8.062S20.063 7.554 20.063 12 16.447 20.062 12.001 20.062z"/></svg><span>Hablar por WhatsApp</span>
          </a>
          <button class="nav-toggle" id="nav-toggle" type="button" aria-label="Abrir navegación" aria-expanded="false" aria-controls="main-nav">
            <span></span><span></span><span></span>
          </button>
        </div>
      </div>
    </header>

    <main id="main-content">
      <section class="hero" aria-labelledby="hero-title">
        <img class="hero-image" src={heroSrc} alt="Fachada de Autos La 15 con vehículos en exhibición al atardecer" width={heroImage.width} height={heroImage.height} fetchpriority="high" />
        <div class="hero-overlay" aria-hidden="true"></div>
        <div class="container hero-inner">
          <div class="hero-content">
            <p class="eyebrow reveal">{homepageCopy.eyebrow}</p>
            <h1 id="hero-title" class="reveal">{homepageCopy.title}</h1>
            <p class="hero-lead reveal">{homepageCopy.description}</p>
            <div class="hero-actions reveal">
              <a href="#catalogo" class="btn btn-primary">Ver vehículos</a>
              <a href={whatsappHref(generalMessage)} class="btn btn-ghost" target="_blank" rel="noopener">Hablar por WhatsApp</a>
            </div>
          </div>
          <span class="hero-scroll-hint" aria-hidden="true">Ver vehículos disponibles <span>↓</span></span>
        </div>
      </section>

      <section class="stats reveal" aria-label="Datos de Autos La 15">
        <div class="container">
          <div class="stats-intro"><p class="section-eyebrow">Una trayectoria que conoces</p><p>Datos concretos de una familia que trabaja en el Zulia desde 2005.</p></div>
          <div class="stats-grid">
            <div class="stat"><span class="stat-num" data-count-to="2005">0</span><span class="stat-label">Año en que comenzamos</span></div>
            <div class="stat"><span class="stat-num" data-count-to="20" data-suffix="+">0</span><span class="stat-label">Más de 20 años de trayectoria</span></div>
            <div class="stat"><span class="stat-num" data-count-to="2">0</span><span class="stat-label">Ciudades: Maracaibo y Ciudad Ojeda</span></div>
            <div class="stat"><span class="stat-num" data-count-to="100" data-suffix="%">0</span><span class="stat-label">Papeles originales</span></div>
          </div>
        </div>
      </section>

      <section class="section" id="nosotros" aria-labelledby="history-title">
        <div class="container history-grid">
          <div class="history-media reveal"><img src={historySrc} alt="Fachada de Autos La 15 en Maracaibo con vehículos en exhibición" width={whoAreWeImage.width} height={whoAreWeImage.height} loading="lazy" /></div>
          <div class="history-copy">
            <p class="section-eyebrow reveal">Nuestra historia</p>
            <h2 id="history-title" class="reveal">Una familia que conoce el camino</h2>
            <p class="section-lead reveal">Somos una empresa familiar que atiende a la comunidad del Zulia desde 2005. Trabajamos en Maracaibo y Ciudad Ojeda, donde hemos visto pasar miles de vehículos y, sobre todo, hemos construido la confianza de miles de familias zulianas.</p>
            <p class="section-lead reveal">Empezamos con una idea sencilla: comprar y vender como nos gustaría que nos atendieran, con un proceso claro, opciones atractivas y papeles 100% originales. Esa forma de trabajar sigue guiándonos. Hoy reunimos más de 20 años de experiencia, trato honesto y orientación práctica para que tomes una decisión bien informada.</p>
          </div>
        </div>
      </section>

      <section class="showcase" id="catalogo" aria-labelledby="catalog-title">
        <div class="container showcase-intro">
          <p class="section-eyebrow reveal">Vehículos disponibles</p>
          <h2 id="catalog-title" class="reveal">{homepageCopy.catalogHeading}</h2>
          <p class="section-lead reveal">Conoce nuestra selección de vehículos nuevos y usados. Recorre cada uno a pantalla completa. Los precios mostrados corresponden a la actualización de septiembre.</p>
        </div>
        {cars.length > 0 ? (
          <div class="showcase-body">
            <nav class="showcase-rail" aria-label="Índice de vehículos">
              <p class="showcase-rail-label">Inventario</p>
              <ol>
                {cars.map((car, index) => (
                  <li>
                    <a href={`#vehiculo-${car._id}`} data-showcase-link={index} class:list={[index === 0 && 'is-active']} aria-current={index === 0 ? 'true' : undefined}>
                      <span class="showcase-rail-index">{String(index + 1).padStart(2, '0')}</span>
                      <span>{car.name}</span>
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
            <div class="showcase-panels">
              {cars.map((car, index) => {
                const nextCar = cars[index + 1];
                return (
                  <article class="vehicle-panel" id={`vehiculo-${car._id}`} data-showcase-panel={index} aria-labelledby={`vehiculo-titulo-${car._id}`}>
                    <div class="vehicle-layout">
                      <div class="vehicle-copy">
                        <p class="vehicle-kicker">{conditionLabel(car)} · {car.year}</p>
                        <h3 id={`vehiculo-titulo-${car._id}`}>{car.name}</h3>
                        <p class="vehicle-price">{formatPrice(car.price)}</p>
                        {car.description && <p class="vehicle-desc">{car.description}</p>}
                        <a class="btn btn-primary" target="_blank" rel="noopener" href={whatsappHref(car.whatsappMessage ?? `Hola AUTOS LA 15, me interesa el ${car.name}. ¿Me comparten más información?`)}>Consultar vehículo</a>
                      </div>
                      <div class="vehicle-photo">
                        <img src={imageUrl(car.image, 1600)} alt={car.image?.alt ?? `${car.name}, vehículo de Autos La 15`} width="1080" height="1080" loading={index === 0 ? 'eager' : 'lazy'} />
                      </div>
                    </div>
                    {nextCar && (
                      <a class="vehicle-next" href={`#vehiculo-${nextCar._id}`}>
                        Siguiente vehículo
                        <span aria-hidden="true">↓</span>
                      </a>
                    )}
                    <dl class="vehicle-specs">
                      <div>
                        <dt>Año</dt>
                        <dd>{car.year}</dd>
                      </div>
                      <div>
                        <dt>Estado</dt>
                        <dd>{conditionLabel(car)}</dd>
                      </div>
                      <div>
                        <dt>Precio</dt>
                        <dd>{formatPrice(car.price)}</dd>
                      </div>
                    </dl>
                  </article>
                );
              })}
            </div>
          </div>
        ) : (
          <div class="container">
            <p class="section-lead">En este momento no hay vehículos publicados. Escríbenos y te contamos qué está por llegar.</p>
          </div>
        )}
        <div class="container">
          <p class="catalog-note reveal">¿Quieres vender o dejar tu vehículo en consignación? <a href="#faq">Conoce el proceso</a>.</p>
        </div>
      </section>

      <section class="section" id="testimonios" aria-labelledby="testimonials-title">
        <div class="container">
          <p class="section-eyebrow reveal">Experiencias de quienes nos eligieron</p>
          <h2 id="testimonials-title" class="reveal">La confianza también se cuenta</h2>
          <div class="testimonial-layout">
            <article class="testimonial-feature reveal"><span class="quote-mark" aria-hidden="true">“</span><div class="stars" aria-label="5 de 5 estrellas"><span aria-hidden="true">★★★★★</span></div><p>“Excelente atención en este concesionario. Compré mi Super Duty y el trato fue impecable de inicio a fin. Rápidos, claros y muy profesionales. Sin duda, volvería a comprar aquí. Totalmente recomendados.”</p><span class="testimonial-author">Alfredo Gutiérrez · Mayo 2026</span></article>
            <div class="testimonial-support">
              <article class="testimonial-card reveal"><div class="stars" aria-label="5 de 5 estrellas"><span aria-hidden="true">★★★★★</span></div><p>“Encontré el auto perfecto para mi familia. El equipo fue muy paciente y amable con todas mis dudas.”</p><span class="testimonial-author">Cliente de Autos LA 15</span></article>
              <article class="testimonial-card reveal"><div class="stars" aria-label="5 de 5 estrellas"><span aria-hidden="true">★★★★★</span></div><p>“Vendí mi usado y me dieron un precio justo. La transacción fue rápida y segura. Gracias por todo.”</p><span class="testimonial-author">Cliente de Autos LA 15</span></article>
              <article class="testimonial-card reveal"><div class="stars" aria-label="5 de 5 estrellas"><span aria-hidden="true">★★★★★</span></div><p>“Amplia variedad de modelos y con opciones de financiamiento. Logré comprar mi primer auto con facilidades.”</p><span class="testimonial-author">Cliente de Autos LA 15</span></article>
            </div>
          </div>
        </div>
      </section>

      <section class="section section-alt" id="faq" aria-labelledby="faq-title">
        <div class="container faq-layout">
          <div class="faq-intro reveal"><p class="section-eyebrow">Información para decidir</p><h2 id="faq-title">Antes de comprar o vender</h2><p>Aquí tienes respuestas claras sobre financiamiento, garantías, visitas y consignación.</p><a class="text-link" href="#contacto">Hablar con el equipo <span aria-hidden="true">↗</span></a></div>
          <ol class="faq-list reveal">
            <li class="faq-item"><details open><summary><span>¿Tienen opciones de financiamiento?</span></summary><div class="faq-content"><p>Sí. Trabajamos con una financiadora externa al concesionario. Esta financiadora exige una cuota inicial del 60% del monto total y hasta 1 año para pagar el 40% restante. Los principales requisitos son los últimos 6 movimientos bancarios de la cuenta desde donde se financiaría el vehículo, 2 referencias bancarias, 1 referencia personal, la hoja de vida del aplicante y el registro mercantil, solo si el cliente lo posee.</p><p>Para financiar, primero debes asegurar el vehículo contra todo riesgo. Nosotros cotizamos la póliza y asistimos en el proceso. También debes instalar un dispositivo GPS durante el tiempo que el vehículo sea financiado, con un costo de $300 al año. Por último, debes asumir el documento de compraventa, con un costo aproximado de $400 que incluye revisión INTT y notaría.</p></div></details></li>
            <li class="faq-item"><details><summary><span>¿Qué garantía tiene cada vehículo?</span></summary><div class="faq-content"><p>El inventario incluye opciones nuevas, seminuevas y usadas. Los carros nuevos tienen garantía, pero los años y el kilometraje varían según cada opción. Las seminuevas pueden conservar una garantía vigente, así que conviene consultar el caso puntual. Las opciones usadas no cuentan con garantía. Recomendamos venir con un mecánico de confianza y hacer una prueba de manejo antes de decidir.</p></div></details></li>
            <li class="faq-item"><details><summary><span>¿Cómo agendo una visita?</span></summary><div class="faq-content"><p>Puedes reservar una cita por Instagram o WhatsApp para ver los modelos. Estamos abiertos de lunes a viernes de 8:30am a 5pm y sábados de 9am a 1pm.</p></div></details></li>
            <li class="faq-item"><details><summary><span>¿Puedo vender o consignar mi vehículo?</span></summary><div class="faq-content"><p>Sí, manejamos 2 opciones. Puedes traernos tu vehículo y, si nos interesa después de verlo y probarlo, conversamos. Si lo valoramos a un precio justo para ambos, te hacemos una oferta directa. La segunda opción es dejarlo a consignación: lo exhibimos como parte del inventario y cobramos una comisión al venderlo. La comisión varía según el monto del vehículo y se coordina al firmar el contrato.</p></div></details></li>
          </ol>
        </div>
      </section>

      <section class="section contact-section" id="contacto" aria-labelledby="contact-title">
        <div class="container">
          <div class="contact-heading reveal">
            <div class="contact-heading-title"><h2 id="contact-title">Tu próximo vehículo<br />empieza aquí</h2></div>
            <div class="contact-heading-copy"><p class="section-eyebrow">Solicita información</p><p class="contact-heading-lead">Cuéntanos qué estás buscando, visítanos en Maracaibo o Ciudad Ojeda, o escríbenos directamente por WhatsApp.</p></div>
          </div>
          <div class="contact-cards">
            <article class="contact-card reveal"><span class="contact-card-number">01</span><h3>Compra o vende</h3><p>Revisa opciones nuevas, seminuevas y usadas, o conversemos sobre tu vehículo.</p><a class="contact-card-link" href="#catalogo">Ver vehículos <span aria-hidden="true">↗</span></a></article>
            <article class="contact-card reveal"><span class="contact-card-number">02</span><h3>Visítanos</h3><p>Estamos en Maracaibo y Ciudad Ojeda para atenderte durante nuestro horario de atención.</p><div class="contact-card-details"><a href={`tel:${contact.phone ?? ''}`}>{contact.phone}</a>{hours.map((hour) => <span>{hour.label}: {hour.opening} - {hour.closing}</span>)}</div></article>
            <article class="contact-card reveal"><span class="contact-card-number">03</span><h3>Consulta al equipo</h3><p>Pregúntanos sobre vehículos, financiamiento, garantías o consignación.</p><div class="contact-card-details"><a class="contact-detail-link" href={`mailto:${contact.email ?? ''}`} aria-label={`Enviar correo a ${contact.email}`}><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path></svg><span>{contact.email}</span></a>{siteSettings.socialLinks?.instagram && <a class="contact-detail-link" href={siteSettings.socialLinks.instagram} target="_blank" rel="noopener" aria-label="Visitar el perfil de Instagram de Autos La 15"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle></svg><span>@autosla15</span></a>}</div></article>
          </div>
          <div class="contact-actions reveal"><div class="contact-location"><span class="contact-icon" aria-hidden="true">⌖</span><span><strong>Dónde encontrarnos</strong><br />{locations.map((location, index) => <span>{location.address}{index < locations.length - 1 ? ' · ' : ''}</span>)}</span></div><a class="btn btn-whatsapp contact-cta" href={whatsappHref(generalMessage)} target="_blank" rel="noopener">Hablar por WhatsApp</a></div>
          {mapSrc && <div class="contact-map reveal"><iframe src={mapSrc} width="100%" height="100%" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title={`Mapa de ubicación de ${brandName} en ${firstLocation?.city}`}></iframe></div>}
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div class="footer-lockup"><a href="#top" class="brand"><img src="/assets/img/logo.png" alt={`Logo de ${brandName}`} class="brand-logo" width="40" height="40" /><span class="brand-text"><strong>{brandName}</strong></span></a><p>{tagline}</p></div>
        <nav class="footer-nav" aria-label="Navegación del pie de página"><a href="#nosotros">Nuestra historia</a><a href="#catalogo">Vehículos</a><a href="#testimonios">Opiniones</a><a href="#faq">Preguntas</a><a href="#contacto">Contacto</a></nav>
        <div class="footer-actions">
          <a class="footer-action" href={whatsappHref(generalMessage)} target="_blank" rel="noopener">Hablar por WhatsApp <span aria-hidden="true">↗</span></a>
          {siteSettings.socialLinks?.instagram && <a class="footer-action footer-action-instagram" href={siteSettings.socialLinks.instagram} target="_blank" rel="noopener" aria-label="Visitar el perfil de Instagram de Autos La 15"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle></svg><span>Ver Instagram</span></a>}
        </div>
        <p class="footer-copy">© 2026 {brandName}. Todos los derechos reservados.</p>
      </div>
    </footer>

