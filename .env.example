# Copy to .env for local development. Never commit .env.

# Required for build + Studio (same values as Vercel Production/Preview)
SANITY_PROJECT_ID=7mz74qpp
SANITY_DATASET=production
SANITY_API_VERSION=2026-09-21

# Required on Vercel for canonical URLs and sitemap. Locally, set for production-like builds:
# PUBLIC_SITE_URL=https://autos-la-15.vercel.app
PUBLIC_SITE_URL=

# Local only — seed script and Sanity Management API (webhook setup). Not used on Vercel static build.
# SANITY_TOKEN=

# Local only — Vercel deploy hook URL after: npx vercel deploy-hook create sanity-cms-rebuild --ref main
# Used by scripts/setup-cms-redeploy-webhook.mjs. Never commit.
# VERCEL_DEPLOY_HOOK_URL=
