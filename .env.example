# Copy to .env for local development. Never commit .env.

# Required for build + Studio (same values as Cloudflare Pages Production/Preview)
SANITY_PROJECT_ID=7mz74qpp
SANITY_DATASET=production
SANITY_API_VERSION=2026-09-21

# Required on Cloudflare Pages for canonical URLs and sitemap. Locally, set for production-like builds:
# PUBLIC_SITE_URL=https://autos-la-15.pages.dev
PUBLIC_SITE_URL=

# Local only — seed script and Sanity Management API (webhook setup). Not used on Pages static build.
# SANITY_TOKEN=

# Local only — Cloudflare Pages deploy hook (Settings → Builds → Deploy hooks, branch main).
# Used by scripts/setup-cms-redeploy-webhook.mjs. Never commit.
# PAGES_DEPLOY_HOOK_URL=
